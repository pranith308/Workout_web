# Firebase client (safe to expose in browser — protect data with Firestore rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Git catalog (same repo as Android app)
VITE_GIT_REPO_URL=https://github.com/pranith308/Workout_v2_admin_data.git

# Server-only — local: path to downloaded service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\prani\Downloads\your-firebase-adminsdk.json

# Server-only — Vercel: paste full JSON as one line in the dashboard
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared invite code for signup + forgot PIN (required)
INVITE_CODE=change-me

# Optional hard cap on accounts (default 10)
MAX_USERS=10
