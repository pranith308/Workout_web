# Local development defaults (loaded only by `vite` in dev mode, never by
# `vite build`). These point the app at the Firebase Emulator Suite so the full
# signup/login/plans flow runs locally without any real Firebase or Vercel
# credentials. Safe to commit: no real secrets, emulator-only values.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-workout-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-workout-web
VITE_FIREBASE_APP_ID=1:1234567890:web:demoappid

VITE_GIT_REPO_URL=https://github.com/pranith308/Workout_v2_admin_data.git

# Route the Firebase client SDK to the local emulators.
VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
